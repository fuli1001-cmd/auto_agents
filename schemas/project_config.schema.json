{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-agents.local/project_config.schema.json",
  "title": "auto-agents project config",
  "type": "object",
  "required": [
    "project_name",
    "providers",
    "active_provider",
    "efforts",
    "gates",
    "git",
    "approvals",
    "retries"
  ],
  "properties": {
    "project_name": {
      "type": "string",
      "minLength": 1
    },
    "providers": {
      "type": "object",
      "required": ["codex", "copilot-cli"],
      "properties": {
        "codex": {
          "type": "object",
          "required": [
            "kind",
            "binary",
            "profile_map",
            "extra_args",
            "cwd_flag",
            "prompt_via_stdin",
            "output_flag",
            "subscription_tier"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "const": "codex"
            },
            "binary": {
              "type": "string",
              "minLength": 1
            },
            "profile_map": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "extra_args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "cwd_flag": {
              "type": "string",
              "minLength": 1
            },
            "prompt_via_stdin": {
              "type": "boolean"
            },
            "output_flag": {
              "type": "string",
              "minLength": 1
            },
            "subscription_tier": {
              "type": "string",
              "minLength": 1
            },
            "vision": {
              "type": "string",
              "enum": ["auto", "enabled", "disabled"]
            }
          },
          "additionalProperties": true
        },
        "copilot-cli": {
          "type": "object",
          "required": [
            "kind",
            "binary",
            "profile_map",
            "extra_args",
            "cwd_flag",
            "prompt_via_stdin",
            "output_flag",
            "subscription_tier"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "const": "copilot-cli"
            },
            "binary": {
              "type": "string",
              "minLength": 1
            },
            "profile_map": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "extra_args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "cwd_flag": {
              "type": "string"
            },
            "prompt_via_stdin": {
              "type": "boolean"
            },
            "output_flag": {
              "type": "string"
            },
            "subscription_tier": {
              "type": "string",
              "minLength": 1
            },
            "vision": {
              "type": "string",
              "enum": ["auto", "enabled", "disabled"]
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "active_provider": {
      "type": "string",
      "minLength": 1
    },
    "docs": {
      "type": "object",
      "required": ["language"],
      "properties": {
        "language": {
          "type": "string",
          "enum": ["en", "zh"]
        }
      },
      "additionalProperties": false
    },
    "efforts": {
      "type": "object",
      "properties": {
        "clarify": { "type": "string" },
        "design": { "type": "string" },
        "plan": { "type": "string" },
        "provider_research": { "type": "string" },
        "implement": { "type": "string" },
        "review": { "type": "string" },
        "verify": { "type": "string" },
        "readme": { "type": "string" },
        "visual_judge": { "type": "string" },
        "self_repair": { "type": "string" },
        "evidence_preflight": { "type": "string" }
      },
      "required": [
        "clarify",
        "design",
        "plan",
        "implement",
        "review",
        "verify",
        "readme"
      ],
      "additionalProperties": false
    },
    "gates": {
      "type": "object",
      "required": [
        "commands",
        "require_clean_git_before_task",
        "allow_agent_updates"
      ],
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "runner"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["test"]
              },
              "runner": {
                "type": "string",
                "enum": ["pytest", "vitest"]
              },
              "targets": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "parallel_safe": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "parallel_groups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "commands"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "commands": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          }
        },
        "require_clean_git_before_task": {
          "type": "boolean"
        },
        "allow_agent_updates": {
          "type": "boolean"
        },
        "parallel_workers": {
          "anyOf": [
            {"type": "string", "const": "auto"},
            {"type": "integer", "minimum": 1}
          ]
        },
        "max_auto_workers": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "git": {
      "type": "object",
      "required": [
        "auto_init_repo",
        "commit_message_template"
      ],
      "properties": {
        "auto_init_repo": {
          "type": "boolean"
        },
        "commit_message_template": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "parallel_tasks": {
          "type": "object",
          "required": ["enabled", "workers", "max_auto_workers", "adaptive", "strict", "worktree_root"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "workers": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "auto"
                },
                {
                  "type": "integer",
                  "minimum": 1
                }
              ]
            },
            "max_auto_workers": {
              "type": "integer",
              "minimum": 1
            },
            "adaptive": {
              "type": "boolean"
            },
            "strict": {
              "type": "boolean"
            },
            "worktree_root": {
              "type": "string"
            },
            "pressure_cooldown_seconds": {
              "type": "integer",
              "minimum": 0
            },
            "soft_pressure_threshold": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "recovery": {
          "type": "object",
          "required": ["enabled", "max_rounds", "max_repair_tasks_per_round", "max_refs_per_repair_task"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "max_rounds": {
              "type": "integer",
              "minimum": 1
            },
            "max_repair_tasks_per_round": {
              "type": "integer",
              "minimum": 1
            },
            "max_refs_per_repair_task": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "requirements_audit": {
          "type": "object",
          "properties": {
            "pattern_timeout_ms": {"type": "integer", "minimum": 1},
            "total_timeout_seconds": {"type": "integer", "minimum": 1},
            "cache_enabled": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        "evidence_preflight": {
          "type": "object",
          "properties": {
            "mode": {"type": "string", "enum": ["off", "high_risk", "all"]}
          },
          "additionalProperties": false
        },
        "smart_timeout": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "provider_idle_seconds": {"type": "integer", "minimum": 60},
            "tool_idle_seconds": {"type": "integer", "minimum": 60},
            "semantic_stall_seconds": {"type": "integer", "minimum": 60},
            "safety_ceiling_seconds": {"type": "integer", "minimum": 60},
            "loop_repeat_limit": {"type": "integer", "minimum": 2},
            "same_provider_resume_limit": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "approvals": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "retries": {
      "type": "object",
      "required": [
        "default_max_attempts",
        "per_stage"
      ],
      "properties": {
        "default_max_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "per_stage": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "additionalProperties": false
    },
    "visual_judge": {
      "type": "object",
      "required": ["mode", "threshold", "provider", "max_pairs_per_task", "require_screenshot_artifacts"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["auto", "off", "required"]
        },
        "threshold": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "provider": {
          "type": "string"
        },
        "max_pairs_per_task": {
          "type": "integer",
          "minimum": 1
        },
        "require_screenshot_artifacts": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
