    {
      "id": "CONTROL-FEATURES",
      "trigger": "业务核心和监督器特性不兼容",
      "expected": "业务派发前拒绝，不建立新业务任务",
      "status": "retained",
      "tests": [
        "tests/test_control_feature_protocol.py::test_incompatible_supervisor_refused_before_business_dispatch"
