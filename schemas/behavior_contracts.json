    {
      "id": "CONTROL-REAL-RUNTIME",
      "trigger": "默认入口创建一次、发生阻断、聚焦修复、续验",
      "expected": "同一项目 ID，创建和外部提交计数均为一次",
      "status": "retained",
      "tests": [
        "tests/test_control_runtime_chain.py::test_real_runtime_failure_fix_and_same_project_resume"
