      "id": "CONTROL-PARALLEL",
      "trigger": "执行对应公共入口或恢复步骤：已完成子任务的整合恢复不重调模型",
      "expected": "已完成子任务的整合恢复不重调模型",
      "status": "retained",
      "tests": [
        "tests/test_control_parallel.py::test_interrupted_integration_reuses_completed_children_without_model_calls"
      ]
    },
    {
