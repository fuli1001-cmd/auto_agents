      "status": "retained",
      "tests": [
        "tests/test_control_domains.py::test_variant_approval_copies_complete_package_and_preserves_budget"
      ]
    },
    {
      "id": "CONTROL-ANSWERS",
      "trigger": "执行对应公共入口或恢复步骤：回答后保留额度继续原目标",
      "expected": "回答后保留额度继续原目标",
      "status": "retained",
      "tests": [
        "tests/test_control_operator.py::test_answer_continues_owned_root_without_refunding_calls"
      ]
    },
    {
      "id": "CONTROL-PERSISTENCE",
      "trigger": "执行对应公共入口或恢复步骤：持久化升级保留数据库与原目标",
      "expected": "持久化升级保留数据库与原目标",
      "status": "retained",
      "tests": [
        "tests/test_control_operator.py::test_persistence_upgrade_preserves_goal_status_budget_and_database"
      ]
    },
