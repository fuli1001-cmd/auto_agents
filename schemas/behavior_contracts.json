      "status": "retained",
      "tests": [
        "tests/test_control_convergence.py::test_validation_cannot_replace_the_original_native_payload"
      ]
    },
    {
      "id": "CONTROL-MODEL-PROTOCOL",
      "trigger": "验收已创建对象但终止 JSON 不合法",
