{
  "version": 1,
  "contracts": [
    {
      "id": "CONTROL-MODES",
      "trigger": "分别从公共 CLI 启动 run、fix、collab、provider-resolve",
      "expected": "同一公共入口执行四种业务模式",
      "status": "retained",
      "tests": [
        "tests/test_control_cli.py::test_all_public_modes_share_the_controller"
      ]
    },
    {
      "id": "CONTROL-GOAL",
      "trigger": "项目已有 spec.md，但新 collab 未提供本次目标",
      "expected": "新建目标不采纳历史项目规格",
      "status": "retained",
      "tests": [
        "tests/test_collab_goal_input.py::test_noninteractive_collab_requires_goal_even_when_project_spec_exists"
      ]
    },
    {
      "id": "CONTROL-TERMINAL",
      "trigger": "执行对应公共入口或恢复步骤：终端多行输入与 EOF 保留全文",
      "expected": "终端多行输入与 EOF 保留全文",
      "status": "retained",
      "tests": [
        "tests/test_terminal_submission.py::test_enter_keeps_reading_and_ctrl_d_submits_exact_goal"
      ]
    },
    {
      "id": "CONTROL-ACCEPTANCE-SCOPE",
      "trigger": "目标明确只验收已有功能，模型仍建议 action=run",
      "expected": "已有功能验收不能进入开发流程",
      "status": "retained",
      "tests": [
        "tests/test_control_acceptance_scope.py::test_acceptance_only_cannot_become_a_development_run"
      ]
    },
    {
      "id": "CONTROL-RUNTIME",
      "trigger": "执行对应公共入口或恢复步骤：真实工具产物允许、源码仍受保护",
      "expected": "真实工具产物允许、源码仍受保护",
      "status": "retained",
      "tests": [
        "tests/test_control_acceptance_scope.py::test_tool_runtime_does_not_enter_acceptance_delivery"
      ]
    },
    {
      "id": "CONTROL-FAILURE-PROJECT",
      "trigger": "验收已创建对象并返回 accepted=false，用户恢复同一会话",
      "expected": "验收失败保留同一项目并先诊断",
      "status": "retained",
      "tests": [
        "tests/test_control_acceptance_scope.py::test_failed_acceptance_retains_existing_project_and_diagnoses_before_retry"
      ]
    },
    {
      "id": "CONTROL-NATIVE-RECOVERY",
      "trigger": "外部调用已返回，后置校验误拒绝，随后修正规则",
      "expected": "已知调用结果重新校验而不重发",
      "status": "retained",
      "tests": [
        "tests/test_control_convergence.py::test_native_result_revalidated_without_redispatch_or_refunding"
      ]
    },
    {
      "id": "CONTROL-VERIFICATION-RECOVERY",
      "trigger": "检查已执行且通过，证明解析器误判，随后修正解析器",
      "expected": "复用已执行的检查结果而不再次执行",
      "status": "retained",
      "tests": [
        "tests/test_control_convergence.py::test_known_verification_replays_results_not_the_effectful_test"
      ]
    },
    {
      "id": "CONTROL-VERIFICATION-INPUTS",
      "trigger": "执行对应公共入口或恢复步骤：临时测试源码也必须保持冻结",
      "expected": "临时测试源码也必须保持冻结",
      "status": "retained",
      "tests": [
        "tests/test_control_convergence.py::test_temporary_verification_script_cannot_rewrite_itself"
      ]
    },
    {
      "id": "CONTROL-UNKNOWN",
      "trigger": "调用缺少确认终止回执，用户重复恢复或更换 provider",
      "expected": "未知调用不得重试或切换账户",
      "status": "retained",
      "tests": [
        "tests/test_control_convergence.py::test_unknown_native_result_never_retries_or_switches_provider"
      ]
    },
    {
      "id": "CONTROL-AUTHORIZATION",
      "trigger": "原目标禁止源码修改，模型仍建议 fix",
