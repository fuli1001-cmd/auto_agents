      "status": "retained",
      "tests": [
        "tests/test_control_convergence.py::test_schema_two_upgrade_preserves_identity_and_readers_do_not_migrate"
      ]
    },
    {
      "id": "CONTROL-APPROVAL",
      "trigger": "执行对应公共入口或恢复步骤：原型批准锁定完整包",
