      "status": "retained",
      "tests": [
        "tests/test_control_convergence.py::test_invalid_acceptance_protocol_does_not_repeat_creation"
      ]
    },
    {
      "id": "CONTROL-DEPENDENCIES",
      "trigger": "嵌套应用有已安装的共享依赖",
