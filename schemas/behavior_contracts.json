      "status": "retained",
      "tests": [
        "tests/test_control_reference_contracts.py::test_active_provider_requirement_cannot_be_skipped_by_not_required"
      ]
    },
    {
      "id": "CONTROL-CANCEL",
      "trigger": "执行对应公共入口或恢复步骤：取消不得丢失未知回执和工作区",
      "expected": "取消不得丢失未知回执和工作区",
      "status": "retained",
      "tests": [
        "tests/test_control_behaviors.py::test_cancel_preserves_unknown_receipts_and_workspaces"
      ]
    },
    {
      "id": "CONTROL-CLEANUP",
      "trigger": "执行对应公共入口或恢复步骤：清理必须保留未知操作的租约",
      "expected": "清理必须保留未知操作的租约",
      "status": "retained",
      "tests": [
        "tests/test_control_cleanup.py::test_cancel_cannot_delete_cache_used_by_an_unknown_operation"
      ]
    },
    {
      "id": "CONTROL-WATCH",
      "trigger": "业务状态已恢复，但监督器仍缓存旧的 STOPPED 故障",
      "expected": "完整默认入口必须越过监督器的旧缓存故障",
      "status": "retained",
      "tests": [
        "tests/test_watch_invocation.py::test_bootstrap_resumes_recovered_acceptance_past_stale_supervisor_fault"
      ]
    },
    {
      "id": "CONTROL-RETIREMENT",
      "trigger": "执行对应公共入口或恢复步骤：旧执行器入口不能恢复旧调度循环",
      "expected": "旧执行器入口不能恢复旧调度循环",
      "status": "changed",
      "tests": [
        "tests/test_control_behaviors.py::test_retired_facades_cannot_dispatch_old_execution"
      ],
      "rationale": "保留命令兼容入口，执行统一由新的单控制器负责；旧私有调度分支退役。"
    },
    {
      "id": "CONTROL-OLD-DEVELOPMENT",
      "trigger": "仅验收目标的历史开发子任务已有改动",
      "expected": "必须暂停保留，不能恢复开发执行",
      "status": "retained",
      "tests": [
        "tests/test_control_convergence.py::test_historical_development_cannot_resume_after_its_source_changed"
      ]
