      "status": "retained",
      "tests": [
        "tests/test_control_convergence.py::test_legacy_failed_receipt_without_native_result_stays_blocked"
      ]
    },
    {
      "id": "CONTROL-NATIVE-IMMUTABLE",
      "trigger": "重新校验试图更改原始响应字段",
