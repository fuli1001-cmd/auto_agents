{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-agents.local/task_plan.schema.json",
  "title": "auto-agents task plan",
  "type": "object",
  "required": ["tasks"],
  "properties": {
    "test_strategy": {
      "type": "string"
    },
    "verification_commands": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "items": {
        "type": "object",
        "required": [
          "task_id",
          "title",
          "description",
          "acceptance",
          "status",
          "commit_message"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Requirement IDs from .auto-agents/state/requirements_trace.json covered by this task."
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "type": "string",
            "enum": ["pending", "in_progress", "blocked", "done"]
          },
          "commit_message": {
            "type": "string"
          },
          "scope_boundaries": {
            "type": "string",
            "description": "Explicitly out-of-scope concerns for this task, guiding review boundaries."
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
