{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-agents.local/task_plan.schema.json",
  "title": "auto-agents task plan",
  "type": "object",
  "required": ["tasks"],
  "properties": {
    "verification_policy_version": {
      "type": "integer",
      "enum": [1, 2, 3],
      "description": "Version 3 adds verifiable incremental gate reuse and stable shards."
    },
    "test_strategy": {
      "type": "string"
    },
    "verification_commands": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "runner"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["test"]
          },
          "runner": {
            "type": "string",
            "enum": ["pytest", "vitest"]
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "parallel_safe": {
            "type": "boolean"
          },
          "max_batches": {
            "type": "integer",
            "minimum": 0
          },
          "serial_reason": {
            "type": "string",
            "enum": [
              "artifact_chain",
              "shared_mutable_state",
              "fixed_port",
              "external_side_effect",
              "ordered_contract"
            ]
          },
          "cadence": {
            "type": "string",
            "enum": ["implement_and_final", "final_only"]
          },
          "cache_scope": {
            "type": "string",
            "enum": ["source", "run_context"]
          },
          "result_cache_scope": {
            "type": "string",
            "enum": ["off", "candidate", "observed_inputs", "auto"]
          },
          "resource_class": {
            "type": "string",
            "enum": ["normal", "heavy"]
          },
          "requires": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "exclusive_resources": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(host|pool):.+"
            }
          },
          "dynamic_ports": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "artifact_globs": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    },
    "oracle_proof_schema_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Enables strict requirement oracle proof validation for new task plans."
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "items": {
        "type": "object",
        "required": [
          "task_id",
          "title",
          "description",
          "acceptance",
          "status",
          "commit_message"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Requirement IDs from .auto-agents/state/requirements_trace.json covered by this task."
          },
          "requirement_proofs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "requirement_id",
                "evidence_refs",
                "proof_type",
                "oracle_strength",
                "evidence_boundary",
                "status"
              ],
              "properties": {
                "requirement_id": {
                  "type": "string",
                  "minLength": 1
                },
                "requirement_contract_sha256": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "oracle_index": {
                  "type": "integer",
                  "minimum": 1
                },
                "acceptance_oracle": {
                  "type": "string",
                  "minLength": 1
                },
                "proof_type": {
                  "type": "string",
                  "enum": [
                    "deterministic_test",
                    "integration_test",
                    "runtime_evidence",
                    "human_review",
                    "judge_model",
                    "benchmark",
                    "mixed"
                  ]
                },
                "oracle_strength": {
                  "type": "string",
                  "enum": ["proxy", "behavioral", "semantic", "human"]
                },
                "evidence_boundary": {
                  "type": "string",
                  "enum": ["internal_state", "system_boundary", "external_side_effect"]
                },
                "evidence_refs": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "forbidden_proxy_oracles": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "proxy_oracles": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "visual_evidence": {
                  "description": "Optional explicit same-state prototype-vs-actual raster screenshot pairing for frontend visual fidelity proofs. Ordinary evidence_refs are never inferred as pairs.",
                  "anyOf": [
                    {
                      "type": "object",
                      "required": ["prototype_image_ref", "actual_image_ref"],
                      "properties": {
                        "surface": { "type": "string" },
                        "viewport": { "type": "string" },
                        "purpose": {
                          "type": "string",
                          "description": "prototype_fidelity for prototype-vs-actual visual judge pairs; layout_stability/state_transition/runtime_evidence for screenshots that should not be compared by visual_judge."
                        },
                        "evidence_kind": { "type": "string" },
                        "comparison_type": { "type": "string" },
                        "visual_judge": { "type": "boolean" },
                        "judge": { "type": "boolean" },
                        "prototype_image_ref": { "type": "string", "minLength": 1, "description": "PNG, JPEG, or WebP prototype screenshot; HTML is not an image ref." },
                        "actual_image_ref": { "type": "string", "minLength": 1, "description": "PNG, JPEG, or WebP browser-rendered screenshot for the same UI state." },
                        "prototype_source_ref": { "type": "string", "description": "Optional HTML/Figma/source prototype reference; not attached as an image." }
                      },
                      "additionalProperties": true
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["prototype_image_ref", "actual_image_ref"],
                        "properties": {
                          "surface": { "type": "string" },
                          "viewport": { "type": "string" },
                          "purpose": {
                            "type": "string",
                            "description": "prototype_fidelity for prototype-vs-actual visual judge pairs; layout_stability/state_transition/runtime_evidence for screenshots that should not be compared by visual_judge."
                          },
                          "evidence_kind": { "type": "string" },
                          "comparison_type": { "type": "string" },
                          "visual_judge": { "type": "boolean" },
                          "judge": { "type": "boolean" },
                        "prototype_image_ref": { "type": "string", "minLength": 1, "description": "PNG, JPEG, or WebP prototype screenshot; HTML is not an image ref." },
                        "actual_image_ref": { "type": "string", "minLength": 1, "description": "PNG, JPEG, or WebP browser-rendered screenshot for the same UI state." },
                        "prototype_source_ref": { "type": "string", "description": "Optional HTML/Figma/source prototype reference; not attached as an image." }
                        },
                        "additionalProperties": true
                      }
                    }
                  ]
                },
                "status": {
                  "type": "string",
                  "enum": ["planned", "verified"]
                }
              },
              "additionalProperties": true,
              "anyOf": [
                {
                  "required": ["oracle_index"]
                },
                {
                  "required": ["acceptance_oracle"]
                }
              ]
            },
            "description": "Per-oracle proof expectations and evidence for bound requirement_ids."
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Planner-generated prerequisite task IDs required before this task may run in experimental parallel execution mode."
          },
          "verification_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Precise executable verification refs owned by this task. Version 2 requires them for every active task."
          },
          "task_origin": {
            "type": "string",
            "enum": ["planned", "scope_split", "evidence_repair", "stage_recovery"],
            "description": "Orchestrator-owned task lineage classification."
          },
          "recovery_epoch": {
            "type": "integer",
            "minimum": 0
          },
          "recovery_round": {
            "type": "integer",
            "minimum": 0
          },
          "verify_retry_epoch": {
            "type": "integer",
            "minimum": 0,
            "description": "Orchestrator-owned verification retry lifecycle counter."
          },
          "recovery_history": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Bounded automatic repair scheduling history for this task."
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "type": "string",
            "enum": ["pending", "in_progress", "blocked", "done"]
          },
          "commit_message": {
            "type": "string"
          },
          "scope_boundaries": {
            "type": "string",
            "description": "Explicitly out-of-scope concerns for this task, guiding review boundaries."
          }
        },
        "additionalProperties": true
            }
          },
          "evidence_preflight": {
            "type": "object",
            "properties": {
              "decision": {"type": "string"},
              "reason": {"type": "string"},
              "checklist": {
                "type": "array",
                "items": {"type": "string"}
              },
              "fingerprint": {"type": "string"}
            },
            "additionalProperties": true
          }
  },
  "additionalProperties": false
}
