{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-agents.local/task_plan.schema.json",
  "title": "auto-agents task plan",
  "type": "object",
  "required": ["tasks"],
  "properties": {
    "test_strategy": {
      "type": "string"
    },
    "verification_commands": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "oracle_proof_schema_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Enables strict requirement oracle proof validation for new task plans."
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "items": {
        "type": "object",
        "required": [
          "task_id",
          "title",
          "description",
          "acceptance",
          "status",
          "commit_message"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Requirement IDs from .auto-agents/state/requirements_trace.json covered by this task."
          },
          "requirement_proofs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "requirement_id",
                "evidence_refs",
                "proof_type",
                "oracle_strength",
                "evidence_boundary",
                "status"
              ],
              "properties": {
                "requirement_id": {
                  "type": "string",
                  "minLength": 1
                },
                "oracle_index": {
                  "type": "integer",
                  "minimum": 1
                },
                "acceptance_oracle": {
                  "type": "string",
                  "minLength": 1
                },
                "proof_type": {
                  "type": "string",
                  "enum": [
                    "deterministic_test",
                    "integration_test",
                    "runtime_evidence",
                    "human_review",
                    "judge_model",
                    "benchmark",
                    "mixed"
                  ]
                },
                "oracle_strength": {
                  "type": "string",
                  "enum": ["proxy", "behavioral", "semantic", "human"]
                },
                "evidence_boundary": {
                  "type": "string",
                  "enum": ["internal_state", "system_boundary", "external_side_effect"]
                },
                "evidence_refs": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "forbidden_proxy_oracles": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "proxy_oracles": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "status": {
                  "type": "string",
                  "enum": ["planned", "verified"]
                }
              },
              "additionalProperties": true,
              "anyOf": [
                {
                  "required": ["oracle_index"]
                },
                {
                  "required": ["acceptance_oracle"]
                }
              ]
            },
            "description": "Per-oracle proof expectations and evidence for bound requirement_ids."
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Planner-generated prerequisite task IDs required before this task may run in experimental parallel execution mode."
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "type": "string",
            "enum": ["pending", "in_progress", "blocked", "done"]
          },
          "commit_message": {
            "type": "string"
          },
          "scope_boundaries": {
            "type": "string",
            "description": "Explicitly out-of-scope concerns for this task, guiding review boundaries."
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
