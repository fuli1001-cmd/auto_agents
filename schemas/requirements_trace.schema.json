{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-agents.local/requirements_trace.schema.json",
  "title": "auto-agents requirements trace",
  "type": "object",
  "required": ["version", "requirements"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "contract_identity_schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "frontend_surfaces": {
      "type": "array",
      "description": "Optional page/screen-level visual fidelity contracts derived from prototype artifacts. Omit or leave empty for projects without frontend prototype requirements.",
      "items": {
        "type": "object",
        "required": ["name", "prototype_refs"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "route": {
            "type": "string"
          },
          "prototype_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "viewports": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fidelity": {
            "type": "string",
            "description": "Expected fidelity level, for example layout-and-style, pixel-close, or semantic-visual."
          },
          "validation": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "source",
          "status",
          "priority",
          "acceptance_oracles",
          "oracle_type",
          "oracle_strength",
          "evidence_boundary",
          "forbidden_proxy_oracles",
          "forbidden_patterns",
          "external_docs_required",
          "provider_reference",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["active", "deferred", "superseded"]
          },
          "priority": {
            "type": "string",
            "enum": ["mandatory", "optional"]
          },
          "acceptance_oracles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "oracle_type": {
            "type": "string",
            "enum": [
              "benchmark",
              "deterministic_test",
              "human_review",
              "integration_test",
              "judge_model",
              "mixed",
              "runtime_evidence"
            ]
          },
          "oracle_strength": {
            "type": "string",
            "enum": ["proxy", "behavioral", "semantic", "human"]
          },
          "evidence_boundary": {
            "type": "string",
            "enum": ["internal_state", "system_boundary", "external_side_effect"]
          },
          "forbidden_proxy_oracles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "forbidden_patterns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "external_docs_required": {
            "type": "boolean"
          },
          "provider_reference": {
            "type": "string"
          },
          "provider_references": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          },
          "contract_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "supersedes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "superseded_by": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
