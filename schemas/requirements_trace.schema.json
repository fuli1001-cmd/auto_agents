{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-agents.local/requirements_trace.schema.json",
  "title": "auto-agents requirements trace",
  "type": "object",
  "required": ["version", "requirements"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "persistence_contract_version": {
      "type": "integer",
      "enum": [1, 2]
    },
    "contract_identity_schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "frontend_scope": {
      "type": "object",
      "required": ["requested", "surfaces"],
      "properties": {
        "requested": {"type": "boolean"},
        "surfaces": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "priority", "requirement_ids"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "name": {"type": "string", "minLength": 1},
              "route": {"type": "string"},
              "priority": {
                "type": "string",
                "enum": ["core", "primary", "secondary", "optional"]
              },
              "purpose": {"type": "string"},
              "key_states": {
                "type": "array",
                "items": {"type": "string"}
              },
              "requirement_ids": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": false
    },
    "frontend_surfaces": {
      "type": "array",
      "description": "Optional page/screen-level visual fidelity contracts derived from prototype artifacts. Omit or leave empty for projects without frontend prototype requirements.",
      "items": {
        "type": "object",
        "required": ["name", "prototype_refs"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "route": {
            "type": "string"
          },
          "prototype_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "viewports": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fidelity": {
            "type": "string",
            "description": "Expected fidelity level, for example layout-and-style, pixel-close, or semantic-visual."
          },
          "validation": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "persistence_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "target_ids", "source", "status"],
        "anyOf": [
          {"required": ["strategy"]},
          {"required": ["storage_transition", "compatibility_policy"]}
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^PERSIST-[0-9]{3,}$"},
          "target_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "strategy": {
            "type": "string",
            "enum": [
              "initial_schema",
              "startup_compatible",
              "clean_break",
              "external_operator"
            ]
          },
          "storage_transition": {
            "type": "string",
            "enum": ["initialize", "migrate_in_place", "rebuild", "external_operator", "none"]
          },
          "compatibility_policy": {
            "type": "string",
            "enum": ["not_applicable", "backward_compatible", "migrate_all", "dual_read", "reject_legacy", "operator_defined"]
          },
          "source": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["active", "superseded"]},
          "superseded_by": {"type": "string"},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "persistence_target_proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "environment", "kind", "locator"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$"},
          "environment": {"type": "string", "enum": ["development", "test", "production"]},
          "kind": {"type": "string", "enum": ["local_file", "compose_service"]},
          "locator": {"type": "object"},
          "associated_paths": {"type": "array", "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "source",
          "status",
          "priority",
          "acceptance_oracles",
          "oracle_type",
          "oracle_strength",
          "evidence_boundary",
          "forbidden_proxy_oracles",
          "forbidden_patterns",
          "external_docs_required",
          "provider_reference",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["active", "deferred", "superseded"]
          },
          "priority": {
            "type": "string",
            "enum": ["mandatory", "optional"]
          },
          "acceptance_oracles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "oracle_type": {
            "type": "string",
            "enum": [
              "benchmark",
              "deterministic_test",
              "human_review",
              "integration_test",
              "judge_model",
              "mixed",
              "runtime_evidence"
            ]
          },
          "oracle_strength": {
            "type": "string",
            "enum": ["proxy", "behavioral", "semantic", "human"]
          },
          "evidence_boundary": {
            "type": "string",
            "enum": ["internal_state", "system_boundary", "external_side_effect"]
          },
          "forbidden_proxy_oracles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "forbidden_patterns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "external_docs_required": {
            "type": "boolean"
          },
          "provider_reference": {
            "type": "string"
          },
          "provider_references": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          },
          "contract_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "supersedes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "superseded_by": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
